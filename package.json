{
  "name": "enterprise-knowledge-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -n server,web -c purple,blue \"npm run server\" \"npm run dev\"",
    "dev": "vite --host 0.0.0.0",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit && tsc -p server/tsconfig.json",
    "format": "prettier --write src index.html vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
